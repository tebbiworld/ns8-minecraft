# Return the stored settings plus live server state (mc-monitor inside the
# container: version, players online) and a connection hint (node IP:port).

import json
import os
import re
import subprocess
import sys

env = os.environ

def split_list(s):
    return [x for x in s.split(",") if x]

extra = []
try:
    with open("minecraft-extra.env") as fp:
        extra = [l.rstrip("\n") for l in fp if l.strip() and not l.startswith("#")]
except FileNotFoundError:
    pass

running = False
status = {"version": "", "online": None, "max": None}
try:
    st = subprocess.run(["podman", "inspect", "minecraft", "--format", "{{.State.Status}}"],
                        capture_output=True, text=True, timeout=10).stdout.strip()
    running = st == "running"
    if running:
        out = subprocess.run(["podman", "exec", "minecraft", "mc-monitor", "status", "--host", "127.0.0.1", "--port", "25565"],
                             capture_output=True, text=True, timeout=10).stdout
        m = re.search(r"version=(.+?)\s+online=(\d+)\s+max=(\d+)", out)
        if m:
            status = {"version": m.group(1), "online": int(m.group(2)), "max": int(m.group(3))}
except Exception:
    pass

node_ip = ""
try:
    out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True, timeout=5).stdout
    m = re.search(r"\bsrc (\S+)", out)
    node_ip = m.group(1) if m else ""
except Exception:
    pass

config = {
    "eula_accepted": env.get("EULA_ACCEPTED") == "true",
    "server_type": env.get("SERVER_TYPE", "PAPER"),
    "version": env.get("MC_VERSION", "LATEST"),
    "memory_mb": int(env.get("MEMORY_MB", "2048")),
    "game_port": int(env.get("GAME_PORT", "25565")),
    "bedrock_enabled": env.get("BEDROCK_ENABLED") == "true",
    "bedrock_port": int(env.get("BEDROCK_PORT", "19132")),
    "motd": env.get("MOTD", ""),
    "gamemode": env.get("GAMEMODE", "survival"),
    "difficulty": env.get("DIFFICULTY", "normal"),
    "max_players": int(env.get("MAX_PLAYERS", "20")),
    "pvp": env.get("PVP", "true") == "true",
    "online_mode": env.get("ONLINE_MODE", "true") == "true",
    "whitelist": split_list(env.get("WHITELIST", "")),
    "ops": split_list(env.get("OPS", "")),
    "seed": env.get("SEED", ""),
    "timezone": env.get("TZ", "UTC"),
    "extra_env": extra,
    "server_running": running,
    "server_version": status["version"],
    "players_online": status["online"],
    "players_max": status["max"],
    "node_ip": node_ip,
}
json.dump(config, fp=sys.stdout)
