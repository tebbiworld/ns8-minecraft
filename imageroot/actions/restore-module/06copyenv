# Carry the settings of the backed-up instance over to the new one. The RCON
# password must stay the original: it is already stored in the restored world
# volume's server.properties.

import json
import sys

import agent
import modsecrets

request = json.load(sys.stdin)
if "environment" in request:
    # restore-module: the environment of the backup comes with the request
    env = request["environment"]
else:
    # clone-module (this file is linked there as 20copyenv): the core imports only
    # the variables the new instance does not have yet, so everything preset by
    # create-module would keep its default. The core leaves the source instance's
    # environment in state/environment.clone-module until its last step.
    env = agent.read_envfile("environment.clone-module")
keep = ["EULA_ACCEPTED", "SERVER_TYPE", "MC_VERSION", "MEMORY_MB", "GAME_PORT", "BEDROCK_ENABLED",
        "BEDROCK_PORT", "MOTD", "GAMEMODE", "DIFFICULTY", "MAX_PLAYERS", "PVP", "ONLINE_MODE", "WHITELIST", "OPS", "SEED", "TZ"]
agent.mset_env({k: env[k] for k in keep if k in env})

# The RCON password comes back with the restored state/passwords.env. A backup
# taken with module version 1.0.0 still carries it in the environment.
if env.get("RCON_PASSWORD"):
    modsecrets.write({"RCON_PASSWORD": env["RCON_PASSWORD"]})
    print("restored the legacy RCON password from the backup environment into passwords.env", file=sys.stderr)
