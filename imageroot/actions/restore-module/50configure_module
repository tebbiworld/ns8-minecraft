# Re-run configure-module with the restored settings: env files, firewall
# service on the (possibly different) node, start the server on the restored
# minecraft-data volume.

import os

import agent
import agent.tasks

env = os.environ
extra = []
try:
    with open("minecraft-extra.env") as fp:
        extra = [l.rstrip("\n") for l in fp if l.strip() and not l.startswith("#")]
except FileNotFoundError:
    pass
data = {
    "eula_accepted": env.get("EULA_ACCEPTED") == "true",
    "server_type": env.get("SERVER_TYPE", "PAPER"),
    "version": env.get("MC_VERSION", "LATEST"),
    "memory_mb": int(env.get("MEMORY_MB", "2048")),
    "game_port": int(env.get("GAME_PORT", "25565")),
    "bedrock_enabled": env.get("BEDROCK_ENABLED") == "true",
    "bedrock_port": int(env.get("BEDROCK_PORT", "19132")),
    "motd": env.get("MOTD", ""),
    "gamemode": env.get("GAMEMODE", "survival"),
    "difficulty": env.get("DIFFICULTY", "normal"),
    "max_players": int(env.get("MAX_PLAYERS", "20")),
    "pvp": env.get("PVP", "true") == "true",
    "online_mode": env.get("ONLINE_MODE", "true") == "true",
    "whitelist": [x for x in env.get("WHITELIST", "").split(",") if x],
    "ops": [x for x in env.get("OPS", "").split(",") if x],
    "seed": env.get("SEED", ""),
    "timezone": env.get("TZ", "UTC"),
    "extra_env": extra,
}
response = agent.tasks.run(agent_id=env["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "The configure-module subtask failed!")
