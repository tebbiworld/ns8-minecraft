# Persist the settings in state/environment (loaded by minecraft.service) and
# write the container env files:
#   state/minecraft.env        generated from the settings (itzg variables)
#   state/minecraft-extra.env  the "additional variables" verbatim, applied last

import json
import os
import sys

import agent

data = json.load(sys.stdin)

def flag(v):
    return "true" if v else "false"

server_type = data.get("server_type") or "PAPER"
version = (data.get("version") or "LATEST").strip() or "LATEST"
memory_mb = int(data.get("memory_mb") or 2048)
game_port = int(data.get("game_port") or 25565)
bedrock = bool(data.get("bedrock_enabled", False))
bedrock_port = int(data.get("bedrock_port") or 19132)
whitelist = sorted({n.strip() for n in (data.get("whitelist") or []) if n.strip()})
ops = sorted({n.strip() for n in (data.get("ops") or []) if n.strip()})
timezone = (data.get("timezone") or "UTC").strip() or "UTC"
motd = (data.get("motd") or "").strip()
seed = (data.get("seed") or "").strip()

publish = [f"--publish {game_port}:25565/tcp"]
if bedrock:
    publish.append(f"--publish {bedrock_port}:19132/udp")

agent.mset_env({
    "EULA_ACCEPTED": flag(data.get("eula_accepted")),
    "SERVER_TYPE": server_type,
    "MC_VERSION": version,
    "MEMORY_MB": str(memory_mb),
    "GAME_PORT": str(game_port),
    "BEDROCK_ENABLED": flag(bedrock),
    "BEDROCK_PORT": str(bedrock_port),
    "MINECRAFT_PUBLISH_ARGS": " ".join(publish),
    "MOTD": motd,
    "GAMEMODE": data.get("gamemode") or "survival",
    "DIFFICULTY": data.get("difficulty") or "normal",
    "MAX_PLAYERS": str(int(data.get("max_players") or 20)),
    "PVP": flag(data.get("pvp", True)),
    "ONLINE_MODE": flag(data.get("online_mode", True)),
    "WHITELIST": ",".join(whitelist),
    "OPS": ",".join(ops),
    "SEED": seed,
    "TZ": timezone,
})

# --- Generated container env file -------------------------------------------
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    f"EULA={'TRUE' if data.get('eula_accepted') else 'FALSE'}",
    f"TYPE={server_type}",
    f"VERSION={version}",
    f"MEMORY={memory_mb}M",
    "SERVER_PORT=25565",
    "ENABLE_RCON=true",
    "RCON_PORT=25575",
    f"RCON_PASSWORD={os.environ['RCON_PASSWORD']}",
    # Re-apply the settings-derived server.properties at every start, so a
    # change on the settings page wins over a hand-edited file.
    "OVERRIDE_SERVER_PROPERTIES=true",
    f"MOTD={motd}",
    f"MODE={data.get('gamemode') or 'survival'}",
    f"DIFFICULTY={data.get('difficulty') or 'normal'}",
    f"MAX_PLAYERS={int(data.get('max_players') or 20)}",
    f"PVP={flag(data.get('pvp', True))}",
    f"ONLINE_MODE={flag(data.get('online_mode', True))}",
    f"SEED={seed}",
    f"TZ={timezone}",
    # Whitelist/ops files follow the settings (removals included).
    f"WHITELIST={','.join(whitelist)}",
    f"ENFORCE_WHITELIST={flag(bool(whitelist))}",
    "EXISTING_WHITELIST_FILE=SYNCHRONIZE",
    f"OPS={','.join(ops)}",
    "EXISTING_OPS_FILE=SYNCHRONIZE",
    # Graceful stop: warn players, then save and stop.
    "STOP_SERVER_ANNOUNCE_DELAY=10",
]
# Geyser (Bedrock protocol bridge) + Floodgate (Bedrock players need no Java
# account): the latest Spigot builds from the official GeyserMC download API,
# fetched at every start (Modrinth has no files for every new Minecraft
# version). The two jars are always removed before the download, so switching
# Bedrock off drops them again at the next start.
lines.append("REMOVE_OLD_MODS=true")
lines.append("REMOVE_OLD_MODS_INCLUDE=Geyser-Spigot*.jar,floodgate-spigot*.jar")
if bedrock:
    lines.append("PLUGINS=https://download.geysermc.org/v2/projects/geyser/versions/latest/builds/latest/downloads/spigot,"
                 "https://download.geysermc.org/v2/projects/floodgate/versions/latest/builds/latest/downloads/spigot")
with open("minecraft.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("minecraft.env.tmp", "minecraft.env")

extra = [e.strip() for e in (data.get("extra_env") or []) if e.strip()]
with open("minecraft-extra.env.tmp", "w") as fp:
    fp.write("# Additional variables from the settings page (applied last).\n")
    fp.write("".join(e + "\n" for e in extra))
os.replace("minecraft-extra.env.tmp", "minecraft-extra.env")
