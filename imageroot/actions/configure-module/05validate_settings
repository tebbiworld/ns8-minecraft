# Checks beyond the JSON schema: EULA, port clashes on the node, Bedrock
# needs Paper, heap size against the node memory, reserved variable names.

import json
import os
import subprocess
import sys

import agent

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
errors = []

def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})

if not data.get("eula_accepted"):
    fail("eula_accepted", False, "eula_required")

def port_in_use(port, proto):
    flag = "-tlnH" if proto == "tcp" else "-ulnH"
    out = subprocess.run(["ss", flag, f"sport = :{port}"], capture_output=True, text=True).stdout
    return bool(out.strip())

game_port = int(data["game_port"])
bedrock = bool(data.get("bedrock_enabled", False))
bedrock_port = int(data.get("bedrock_port", 19132))
# Only probe ports that change: the running instance owns its current ones.
if game_port != int(os.environ.get("GAME_PORT", 0)) and port_in_use(game_port, "tcp"):
    fail("game_port", game_port, "port_in_use")
if bedrock:
    cur_udp = int(os.environ.get("BEDROCK_PORT", 0)) if os.environ.get("BEDROCK_ENABLED") == "true" else 0
    if bedrock_port != cur_udp and port_in_use(bedrock_port, "udp"):
        fail("bedrock_port", bedrock_port, "port_in_use")
    if data.get("server_type") != "PAPER":
        fail("bedrock_enabled", True, "bedrock_requires_paper")

mem_total_mb = 0
with open("/proc/meminfo") as fp:
    for line in fp:
        if line.startswith("MemTotal:"):
            mem_total_mb = int(line.split()[1]) // 1024
if mem_total_mb and int(data["memory_mb"]) > mem_total_mb - 512:
    fail("memory_mb", data["memory_mb"], "memory_too_large")

RESERVED = {"EULA", "TYPE", "VERSION", "MEMORY", "SERVER_PORT", "ENABLE_RCON", "RCON_PASSWORD", "RCON_PORT",
            "UID", "GID", "PLUGINS", "REMOVE_OLD_MODS", "REMOVE_OLD_MODS_INCLUDE", "OVERRIDE_SERVER_PROPERTIES"}
seen = set()
for entry in data.get("extra_env") or []:
    key = entry.split("=", 1)[0]
    if key in RESERVED and not (key == "PLUGINS" and not bedrock):
        fail("extra_env", entry, "reserved_variable")
    elif key in seen:
        fail("extra_env", entry, "duplicate_variable")
    seen.add(key)

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(2)
