# Open the game port(s) on the node firewall as a public service named after
# the instance (replace_ports: a port change closes the old one).

import json
import os
import sys

import agent

data = json.load(sys.stdin)
module_id = os.environ["MODULE_ID"]
ports = [f"{int(data['game_port'])}/tcp"]
if data.get("bedrock_enabled"):
    ports.append(f"{int(data.get('bedrock_port') or 19132)}/udp")
agent.assert_exp(agent.add_public_service(module_id, ports, replace_ports=True))
open(".public-service", "w").close()  # remembered for destroy-module
