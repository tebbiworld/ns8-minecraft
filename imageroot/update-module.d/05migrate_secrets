# Up to 1.0.0 the RCON password was stored with agent.mset_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move it to
# state/passwords.env (0600); the value does not change.

import os

import modsecrets

modsecrets.migrate_from_env(["RCON_PASSWORD"])

# minecraft.env carries the RCON password as well
path = os.path.join(os.environ["AGENT_STATE_DIR"], "minecraft.env")
if os.path.exists(path):
    os.chmod(path, 0o600)
